<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a1b2c3d4-1234-5678-9abc-def012345678</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>George</ProviderName>
  <DefaultLocale>pt-PT</DefaultLocale>
  <DisplayName DefaultValue="Verificador de CC" />
  <Description DefaultValue="Avisa quando um email obrigatório não está em CC" />
  <IconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-Samples/main/Samples/outlook-launchevent/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/OfficeDev/Office-Add-in-Samples/main/Samples/outlook-launchevent/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://www.microsoft.com" />

  <AppDomains>
    <AppDomain>https://SEU-DOMINIO-OU-GITHUB-PAGES-AQUI</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://SEU-DOMINIO-OU-GITHUB-PAGES-AQUI/functions.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.10">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <Runtimes>
          <Runtime resid="Functions.Url" lifetime="short">
            <Override type="javascript" resid="Functions.Script.Url" />
          </Runtime>
        </Runtimes>
        <DesktopFormFactor>
          <FunctionFile resid="Functions.Url" />
          <ExtensionPoint xsi:type="LaunchEvent">
            <LaunchEvents>
              <LaunchEvent Type="ItemSend" FunctionName="checkCC" SendMode="PromptUser" />
            </LaunchEvents>
            <SourceLocation resid="Functions.Url" />
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Urls>
        <bt:Url id="Functions.Url" DefaultValue="https://SEU-DOMINIO-OU-GITHUB-PAGES-AQUI/functions.html" />
        <bt:Url id="Functions.Script.Url" DefaultValue="https://SEU-DOMINIO-OU-GITHUB-PAGES-AQUI/functions.js" />
      </bt:Urls>
    </Resources>
  </VersionOverrides>
</OfficeApp>
